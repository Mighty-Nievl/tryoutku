{
  "name": "tryoutku",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "test": "bun test",
    "preview": "wrangler pages dev out",
    "db:apply": "wrangler d1 execute tryoutku-db --remote --file=./schema.sql",
    "deploy": "bun run build && wrangler pages deploy out --project-name tryoutku"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "hono": "^4.13.18",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.162.0"
  }
}
